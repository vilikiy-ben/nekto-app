#!/usr/bin/env bash
# Перед пушем: у всех уходящих коммитов автор и коммиттер с настоящим адресом, а не «имя@имя-компьютера»,
# и без соавторства ИИ-ассистента.
# Ловит то, что не видит pre-commit: rebase, cherry-pick, коммиты с --no-verify (scripts/checks/commit-identity.py).
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  python3 "$ROOT/scripts/checks/commit-identity.py" "$remote_sha" "$local_sha" || status=1
done
exit $status
